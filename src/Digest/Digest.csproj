<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zkd.Demo.Azure.Auth.Services.Digest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Zkd.Demo.Azure.Auth.ServiceDefaults/Zkd.Demo.Azure.Auth.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- SqlClient brings in a vulnerable 9.0.18. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Step 7: SqlClient 7 keeps Entra authentication (Active Directory Managed Identity and friends) in its own package. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
  </ItemGroup>

</Project>
