@page "/what-really-happens"
@model Zkd.Demo.Azure.Auth.Web.Pages.WhatReallyHappens.IndexModel
@{
    ViewData["Title"] = "What really happens";
    ViewData["WhatReallyHappens"] = true;
}

<div id="what-really-happens"
     data-instance="@Model.Entra.Instance"
     data-client-id="@Model.Entra.ClientId"
     data-redirect-uri="@Model.RedirectUri"
     data-calendar-api-client-id="@Model.CalendarApiClientId"
     data-digest-client-id="@Model.DigestClientId">

    @if (!Model.IsConfigured)
    {
        <div class="alert alert-danger">
            <strong>No app registration configured.</strong>
            Set <code>kickass-tenant-id</code> and <code>web-client-id</code> in the Aspire dashboard.
        </div>
    }

    <ul class="nav nav-pills wrh-tabs mb-4" role="tablist">
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-config" data-tab="config">1. Get config</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-challenge" data-tab="challenge">2. Challenge</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-callback" data-tab="callback">3. Callback</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-tokens" data-tab="tokens">4. Tokens</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-api" data-tab="api">5. Call an API</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-refresh" data-tab="refresh">6. Refresh</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-obo" data-tab="obo">7. On-Behalf-Of</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="pill" data-bs-target="#tab-client-credentials" data-tab="client-credentials">8. Client credentials</button></li>
    </ul>

    <div class="tab-content">
        <partial name="_ConfigTab" model="Model" />
        <partial name="_ChallengeTab" model="Model" />
        <partial name="_CallbackTab" />
        @* Both tokens side by side, so they can be compared claim by claim. *@
        <div class="tab-pane fade" id="tab-tokens" role="tabpanel">
            <div class="row row-cols-1 row-cols-lg-2 g-4 mb-3">
                <partial name="_TokenInspector" model="@("id_token")" />
                <partial name="_TokenInspector" model="@("access_token")" />
            </div>
            <div data-token-controls class="d-flex gap-2 mb-4">
                <button data-role="split" type="button" class="btn btn-outline-dark btn-lg">Split</button>
                <button data-role="decode" type="button" class="btn btn-dark btn-lg" disabled>Decode</button>
                <button data-role="raw" type="button" class="btn btn-link btn-lg d-none">Raw</button>
            </div>
            <div class="d-flex gap-2">
                <button id="id-token-goto-exchange" type="button" class="btn btn-outline-dark d-none" data-goto="callback">Exchange the code &rarr;</button>
                <button type="button" class="btn btn-outline-dark d-none" data-goto="api" data-token="access_token">Call an API &rarr;</button>
            </div>
        </div>
        <partial name="_ApiTab" model="Model" />
        <partial name="_RefreshTab" model="Model" />
        <partial name="_OboTab" model="Model" />
        <partial name="_ClientCredentialsTab" model="Model" />
    </div>

    <partial name="_ValidateModal" />
</div>

@if (Model.PostedParameters is not null)
{
    <script id="posted-parameters" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PostedParameters))</script>
}

@section Scripts {
    <script src="~/js/wrh/context.js" asp-append-version="true"></script>
    <script src="~/js/wrh/config.js" asp-append-version="true"></script>
    <script src="~/js/wrh/challenge.js" asp-append-version="true"></script>
    <script src="~/js/wrh/callback.js" asp-append-version="true"></script>
    <script src="~/js/wrh/tokens.js" asp-append-version="true"></script>
    <script src="~/js/wrh/exchange.js" asp-append-version="true"></script>
    <script src="~/js/wrh/api.js" asp-append-version="true"></script>
    <script src="~/js/wrh/refresh.js" asp-append-version="true"></script>
    <script src="~/js/wrh/obo.js" asp-append-version="true"></script>
    <script src="~/js/wrh/client-credentials.js" asp-append-version="true"></script>
    <script src="~/js/wrh/validate.js" asp-append-version="true"></script>
    <script src="~/js/wrh/main.js" asp-append-version="true"></script>
}
