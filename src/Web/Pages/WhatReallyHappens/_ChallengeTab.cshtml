@model Zkd.Demo.Azure.Auth.Web.Pages.WhatReallyHappens.IndexModel

<div class="tab-pane fade" id="tab-challenge" role="tabpanel">
    @* The default is the first option, or the checked ones. Changes are remembered in the browser.
       prompt=consent forces the consent screen when Entra thinks there's nothing to ask. "not sent" leaves prompt out. *@
    <form id="challenge-form" class="row row-cols-1 row-cols-md-2 g-3 mb-4" autocomplete="off">
        <fieldset class="col">
            <div class="option-panel">
                <legend class="panel-title mono">scope</legend>
                <label class="form-check"><input class="form-check-input" type="checkbox" name="scope" value="openid" checked disabled /> <span class="form-check-label mono">openid</span></label>
                @* My API's scopes are whole URIs. The label is the last part, the request has all of it. *@
                @foreach (var (scope, isChecked) in new[] { ("profile", true), ("email", true), ("User.Read", false), ("Calendars.Read", false), (Model.CalendarApiScope, false), (Model.CalendarApiDefaultScope, false), ("offline_access", false) })
                {
                    <label class="form-check" title="@scope"><input class="form-check-input" type="checkbox" name="scope" value="@scope" checked="@isChecked" /> <span class="form-check-label mono">@Zkd.Demo.Azure.Auth.Web.Pages.WhatReallyHappens.IndexModel.ScopeLabel(scope)</span></label>
                }
            </div>
        </fieldset>
        <fieldset class="col">
            <div class="option-panel">
                @foreach (var (name, options) in new[]
                {
                    ("response_type", new[] { "id_token", "code", "code id_token" }),
                    ("response_mode", new[] { "fragment", "form_post", "query" }),
                    ("prompt", new[] { "", "consent", "login", "select_account" }),
                })
                {
                    <label class="panel-title mono option-label" for="challenge-@name">@name</label>
                    <select id="challenge-@name" name="@name" class="form-select mono mb-3">
                        @foreach (var option in options)
                        {
                            <option value="@option">@(option == "" ? "not sent" : option)</option>
                        }
                    </select>
                }
                <div class="panel-title option-label">PKCE</div>
                <label class="form-check"><input class="form-check-input" type="checkbox" name="pkce" checked /> <span class="form-check-label">enabled</span></label>
                <div class="form-text">Only with a code.</div>
            </div>
        </fieldset>
    </form>

    <div class="panel-title">The request</div>
    <pre id="challenge-request" class="mono-panel url-panel mb-3"></pre>

    <details id="challenge-pkce" class="collapsible mb-3 d-none" open>
        <summary class="panel-title">PKCE</summary>
        <pre id="challenge-pkce-output" class="mono-panel url-panel"></pre>
    </details>

    <button id="challenge-send" type="button" class="btn btn-kac btn-lg px-5" disabled="@(!Model.IsConfigured)">Challenge</button>
</div>
