<div class="tab-pane fade" id="tab-callback" role="tabpanel">
    @* What came back. Once the code is exchanged it folds away, the tokens are the story then. *@
    <details id="callback-received" class="collapsible mb-3" open>
        <summary class="panel-title">What came back</summary>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="panel-title mb-0">Came back via</span>
            <span id="callback-via" class="badge text-bg-secondary mono fs-6"></span>
            <span id="callback-state" class="badge mono fs-6"></span>
        </div>

        <div id="callback-error" class="alert alert-danger d-none">
            <div class="mono fw-bold" id="callback-error-code"></div>
            <div class="mono mt-2" id="callback-error-description" style="white-space: pre-wrap"></div>
        </div>

        <div class="panel-title">The response</div>
        <pre id="callback-request" class="mono-panel url-panel mb-3"></pre>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-dark d-none" data-goto="tokens" data-token="id_token">Look at the id_token &rarr;</button>
        </div>
    </details>

    @* Only when there's a code to exchange. The secret is masked here and filled in by the server. *@
    <section id="exchange" class="d-none">
        <div class="panel-title">Exchange the code</div>
        <pre id="exchange-request" class="mono-panel url-panel mb-3"></pre>

        <button id="exchange-send" type="button" class="btn btn-kac btn-lg px-5 mb-4">Exchange</button>

        <div id="exchange-result" class="d-none">
            <details class="collapsible mb-3" open>
                <summary class="panel-title">The response</summary>
                <div id="exchange-response"></div>
            </details>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-dark d-none" data-goto="tokens">Look at the tokens &rarr;</button>
            </div>
        </div>
    </section>
</div>
