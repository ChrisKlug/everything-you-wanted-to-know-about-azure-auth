@model Zkd.Demo.Azure.Auth.Web.Pages.WhatReallyHappens.IndexModel

<div class="tab-pane fade" id="tab-refresh" role="tabpanel">
    <form id="refresh-form" class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-4" autocomplete="off">
        <fieldset class="col">
            <div class="option-panel">
                <legend class="panel-title mono">scope</legend>
                @* An access token is for one API, so it's one or the other. Calendars.Read was never consented: it fails. *@
                @foreach (var (scope, isChecked) in new[] { ("User.Read", true), (Model.CalendarApiScope, false), ("Calendars.Read", false) })
                {
                    <label class="form-check" title="@scope"><input class="form-check-input" type="radio" name="resource" value="@scope" checked="@isChecked" /> <span class="form-check-label mono">@scope.Split('/')[^1]</span></label>
                }
            </div>
        </fieldset>
    </form>

    <div class="panel-title">The request</div>
    <pre id="refresh-request" class="mono-panel url-panel mb-3"></pre>

    <button id="refresh-send" type="button" class="btn btn-kac btn-lg px-5 mb-4">Refresh</button>

    @* Every refresh token so far. Each use hands back a new one, and the one sent is used up. *@
    <div class="panel-title">The refresh tokens</div>
    <div id="refresh-chain" class="mono-panel refresh-chain mb-4"></div>

    <div id="refresh-result" class="d-none">
        <details class="collapsible mb-3" open>
            <summary class="panel-title">The response</summary>
            <div id="refresh-response"></div>
        </details>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-dark d-none" data-goto="tokens" data-token="access_token">Look at the access_token &rarr;</button>
            <button type="button" class="btn btn-outline-dark d-none" data-goto="api">Call an API &rarr;</button>
        </div>
    </div>
</div>
