@model Zkd.Demo.Azure.Auth.Web.Pages.WhatReallyHappens.IndexModel

@* An app with no user: its own credentials, straight to the token endpoint. No redirect, no sign-in, no code. *@
<div class="tab-pane fade" id="tab-client-credentials" role="tabpanel">
    @if (string.IsNullOrEmpty(Model.DigestClientId) || Model.DigestClientId == "not-registered-yet")
    {
        <div class="alert alert-warning">The Digest isn't registered yet. Set <code>digest-client-id</code> and <code>digest-client-secret</code> in the Aspire dashboard.</div>
    }

    <form id="client-credentials-form" class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-4" autocomplete="off">
        <fieldset class="col">
            <div class="option-panel">
                <legend class="panel-title mono">client_id</legend>
                @* The web has a secret too, and no role. Asking as the web shows what Assignment required does. *@
                @foreach (var (clientId, name, isChecked) in new[] { (Model.DigestClientId, "Kick-Ass Calendar Digest", true), (Model.Entra.ClientId, "Kick-Ass Calendar", false) })
                {
                    <label class="form-check" title="@clientId"><input class="form-check-input" type="radio" name="client_id" value="@clientId" checked="@isChecked" /> <span class="form-check-label">@name</span></label>
                }
            </div>
        </fieldset>
        <fieldset class="col">
            <div class="option-panel">
                <legend class="panel-title mono">scope</legend>
                @* An app can only ask for .default. The named one is there to show Entra saying so (AADSTS1002012). *@
                @foreach (var (scope, isChecked) in new[] { (Model.CalendarApiDefaultScope, true), (Model.CalendarApiAppRoleScope, false) })
                {
                    <label class="form-check" title="@scope"><input class="form-check-input" type="radio" name="scope" value="@scope" checked="@isChecked" /> <span class="form-check-label mono">@IndexModel.ScopeLabel(scope)</span></label>
                }
            </div>
        </fieldset>
    </form>

    <div class="panel-title">The request</div>
    <pre id="client-credentials-request" class="mono-panel url-panel mb-3"></pre>

    <button id="client-credentials-send" type="button" class="btn btn-kac btn-lg px-5 mb-4">Get a token</button>

    <div id="client-credentials-result" class="d-none">
        <details class="collapsible mb-3" open>
            <summary class="panel-title">The response</summary>
            <div id="client-credentials-response"></div>
        </details>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-dark d-none" data-goto="tokens" data-token="access_token">Look at the access_token &rarr;</button>
            <button type="button" class="btn btn-outline-dark d-none" data-goto="api">Call an API &rarr;</button>
        </div>
    </div>
</div>
