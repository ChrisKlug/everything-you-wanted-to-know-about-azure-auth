@model Zkd.Demo.Azure.Auth.Web.Pages.WhatReallyHappens.IndexModel

@* What the Calendar API does with the token it gets: trade it for a Graph token, as the same user. *@
<div class="tab-pane fade" id="tab-obo" role="tabpanel">
    @if (string.IsNullOrEmpty(Model.CalendarApiClientId) || Model.CalendarApiClientId == "not-registered-yet")
    {
        <div class="alert alert-warning">Set <code>calendar-api-client-id</code> in the Aspire dashboard.</div>
    }

    @* After a 200 the access token is the Graph token. Only Graph can verify that, so Entra refuses it as an assertion. *@
    <div id="obo-wrong-audience" class="alert alert-warning d-none">
        This access token is for <code id="obo-audience"></code>, not the Calendar API. Entra will refuse it (AADSTS50013).
        <button id="obo-goto-refresh" type="button" class="btn btn-link p-0 align-baseline">Refresh with <code>KickAssCalendar.Read</code> on Tab 6</button> first.
    </div>

    <div class="panel-title">The request, sent as the Calendar API</div>
    <pre id="obo-request" class="mono-panel url-panel mb-3"></pre>

    <button id="obo-send" type="button" class="btn btn-kac btn-lg px-5 mb-4">Exchange</button>

    <div id="obo-result" class="d-none">
        <details class="collapsible mb-3" open>
            <summary class="panel-title">The response</summary>
            <div id="obo-response"></div>
        </details>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-dark d-none" data-goto="tokens" data-token="access_token">Look at the access_token &rarr;</button>
            <button type="button" class="btn btn-outline-dark d-none" data-goto="api">Call an API &rarr;</button>
        </div>
    </div>
</div>
