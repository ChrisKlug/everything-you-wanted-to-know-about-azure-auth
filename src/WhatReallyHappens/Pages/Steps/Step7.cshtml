@page "/step-7"
@model Zkd.Demo.Azure.Auth.WhatReallyHappens.Pages.Steps.Step7Model
@{
    ViewData["Title"] = "Step 7";
    ViewData["Step"] = "Step 7: Managed identity";
}

<div id="step" class="step">
    <section data-section="pasted" class="step-section">
        <h2 class="step-heading"><span class="step-number">1</span> The tokens from the token service's log</h2>
        <p class="step-note">On my laptop the token service plays Azure: the managed identity's token out, my Google login in. Paste both from its log.</p>
        <partial name="_PastedTokens" model="@((IReadOnlyList<(string, string)>)[("managed_identity_token", "Token for https://database.windows.net/"), ("google_token", "New Google ID token")])" />
    </section>

    <partial name="_StepFooter" model="7" />
</div>

@section Scripts {
    <script src="~/js/parts.js" asp-append-version="true"></script>
    <script src="~/js/steps/step-7.js" asp-append-version="true"></script>
}
