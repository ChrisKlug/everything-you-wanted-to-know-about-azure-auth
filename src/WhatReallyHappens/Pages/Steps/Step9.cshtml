@page "/step-9"
@model Zkd.Demo.Azure.Auth.WhatReallyHappens.Pages.Steps.Step9Model
@{
    ViewData["Title"] = "Step 9";
    ViewData["Step"] = "Step 9: The digest across tenants";
}

<div id="step" class="step">
    <section data-section="pasted" class="step-section">
        <h2 class="step-heading"><span class="step-number">1</span> Two token requests</h2>
        <p class="step-note">The first proves who the digest is. The second is who it is in InGen. Paste both from the logs.</p>
        <partial name="_PastedTokens" model="@((IReadOnlyList<(string, string)>)[("exchange_token", "Token for api://AzureADTokenExchange (token service)"), ("graph_token", "Graph token for Hammond (digest)")])" />
    </section>

    <partial name="_StepFooter" model="9" />
</div>

@section Scripts {
    <script src="~/js/parts.js" asp-append-version="true"></script>
    <script src="~/js/steps/step-9.js" asp-append-version="true"></script>
}
