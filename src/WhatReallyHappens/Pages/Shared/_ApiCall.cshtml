@model Zkd.Demo.Azure.Auth.WhatReallyHappens.Pages.Shared.ApiCallOptions

@* Call something with a bearer token. Any token the step has, so we can see what happens with the wrong one. *@
<div class="row g-3 mb-4">
    <div class="col-md-9">
        <label class="form-label d-block">url
            <input data-role="url" class="form-control form-control-lg mono" value="@Model.Presets[0].Calls[0].Url" autocomplete="off" spellcheck="false" />
        </label>
        <select data-role="preset" class="form-select mono mt-2 w-auto" aria-label="Presets">
            <option value="">Choose a preset…</option>
            @foreach (var (group, calls) in Model.Presets)
            {
                <optgroup label="@group">
                    @foreach (var (label, url) in calls)
                    {
                        <option value="@url">@label</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label d-block">token
            <select data-role="token" class="form-select form-select-lg mono">
                @foreach (var token in Model.Tokens)
                {
                    <option value="@token">@Zkd.Demo.Azure.Auth.WhatReallyHappens.Pages.Shared.TokenNames.Label(token)</option>
                }
                <option value="">(none)</option>
            </select>
        </label>
    </div>
</div>

<div class="panel-title">The request</div>
<pre data-role="request" class="mono-panel url-panel mb-3"></pre>
<button data-role="send" type="button" class="btn btn-kac btn-lg px-5 mb-4">Send</button>
<div data-role="result" class="d-none">
    <div class="panel-title">The response</div>
    <div data-role="response"></div>
</div>
