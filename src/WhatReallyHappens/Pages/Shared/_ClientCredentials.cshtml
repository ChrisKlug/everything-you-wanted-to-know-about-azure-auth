@using Zkd.Demo.Azure.Auth.WhatReallyHappens.Pages.Shared
@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<EntraOptions> Entra
@{
    var digestClientId = Configuration["Digest:ClientId"];
}

@if (digestClientId is null or "not-registered-yet")
{
    <div class="alert alert-warning">The Digest isn't registered yet. Set <code>digest-client-id</code> and <code>digest-client-secret</code> in the Aspire dashboard.</div>
}

<form data-role="form" class="row row-cols-1 row-cols-md-2 g-3 mb-4" autocomplete="off">
    <fieldset class="col">
        <div class="option-panel">
            <legend class="panel-title mono">client_id</legend>
            @* The web has a secret too, and no role. Asking as the web shows what Assignment required does. *@
            @foreach (var (clientId, name, isChecked) in new[] { (digestClientId, "Kick-Ass Calendar Digest", true), (Entra.Value.ClientId, "Kick-Ass Calendar", false) })
            {
                <label class="form-check" title="@clientId"><input class="form-check-input" type="radio" name="client_id" value="@clientId" checked="@isChecked" /> <span class="form-check-label">@name</span></label>
            }
        </div>
    </fieldset>
    <fieldset class="col">
        <div class="option-panel">
            <legend class="panel-title mono">scope</legend>
            @* The role the API's 403 asks for, first, so Entra can say no to it (AADSTS1002012): an app can only ask for .default. *@
            @foreach (var (scope, isChecked) in new[] { (Apis.AppRoleScope, true), (Apis.DefaultScope, false) })
            {
                <label class="form-check" title="@scope"><input class="form-check-input" type="radio" name="scope" value="@scope" checked="@isChecked" /> <span class="form-check-label mono">@ChallengeOptions.Label(scope)</span></label>
            }
        </div>
    </fieldset>
</form>

<partial name="_TokenRequest" model="@("Get a token")" />
