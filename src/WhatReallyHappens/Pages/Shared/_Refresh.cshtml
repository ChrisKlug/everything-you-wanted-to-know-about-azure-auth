@using Zkd.Demo.Azure.Auth.WhatReallyHappens.Pages.Shared

@* One or the other: an access token is for one API. Calendars.Read was never consented, so it fails. *@
<form data-role="form" class="mb-4" autocomplete="off">
    <div class="option-panel d-inline-block pe-5">
        <div class="panel-title mono">scope</div>
        @foreach (var (scope, isChecked) in new[] { ("User.Read", true), ("Calendars.Read", false) })
        {
            <label class="form-check" title="@scope"><input class="form-check-input" type="radio" name="scope" value="@scope" checked="@isChecked" /> <span class="form-check-label mono">@ChallengeOptions.Label(scope)</span></label>
        }
    </div>
</form>

@* Every refresh token so far. Each use hands back a new one, and the one sent is used up. *@
<div class="panel-title">The refresh tokens</div>
<div data-role="chain" class="mono-panel refresh-chain mb-4"></div>

<partial name="_TokenRequest" model="@("Refresh")" />
