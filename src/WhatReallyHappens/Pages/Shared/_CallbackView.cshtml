@* What Entra sent back, however it was sent. *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="panel-title mb-0">Came back via</span>
    <span data-role="via" class="badge text-bg-secondary mono fs-6"></span>
    <span data-role="state" class="badge mono fs-6"></span>
</div>

<div data-role="error" class="alert alert-danger d-none">
    <div data-role="error-code" class="mono fw-bold"></div>
    <div data-role="error-description" class="mono mt-2" style="white-space: pre-wrap"></div>
</div>

<pre data-role="response" class="mono-panel url-panel mb-3"></pre>
