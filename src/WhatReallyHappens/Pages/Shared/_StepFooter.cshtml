@model int
@using Zkd.Demo.Azure.Auth.WhatReallyHappens.Pages.Slides
@{
    // The steps on the start page. The last one goes back there.
    const int lastStep = 11;
}

@* What happened, as slides, and on to the next step. *@
<footer class="step-footer">
    @foreach (var slide in SlideDeck.ForStep(Model))
    {
        <a class="btn btn-outline-dark" href="/slides/@slide.Name">@slide.Title &rarr;</a>
    }
    @if (Model < lastStep)
    {
        <a class="btn btn-kac btn-lg px-5 ms-auto" href="/step-@(Model + 1)">Next: step @(Model + 1) &rarr;</a>
    }
    else
    {
        <a class="btn btn-kac btn-lg px-5 ms-auto" href="/">All steps &rarr;</a>
    }
</footer>
